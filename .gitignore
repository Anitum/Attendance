# Ignore all files and directories by default
*
!*/

# Don't ignore specific directories you want to keep
!motionDetector/**
!old/**

# For trash directory, keep only files (not subdirectories)
!trash/
!trash/*.py
!trash/*.sh
!trash/*.txt
# Add any other file extensions you want to keep in trash

# Ignore all subdirectories inside trash
trash/*/

# Ignore all JSON files
*.json

# Ignore all PEM files
*.pem

# Ignore all PT files
*.pt

# Ignore all key files
*.key

# Ignore all PUB files
*.PUB
*.pub

# Re-include specific files you want to track
!.gitignore
!*.py
!*.sh

# Ignore specific directories explicitly
.aws/
.cache/
.config/
.dotnet/
.git/
.local/
.ssh/
.vscode-server/
__pycache__/
ProcessedFaces/
PushToAWSandGrey/
Results/
faceDetectionTrack/
faceDetections/
faceDetections90/
faceDetectionsOld/
face_recognition_results/
intel/
logs/
model*benching/
"model benching"/
models/
open_model_zoo/
output_frames/
processing/
recognizedFaces/
results/
testing_greythr_attendance/
track_continuity/

# For directories with spaces, try alternative syntax
"model benching"/**
'model benching'/**

# Explicitly ignore these problematic directories with all content
.local/**
models/**
